# Local email / unsubscribe test values for @edu-service/email + API composition.
# Copy the needed keys into the API process env (packages/api/.env or your shell).
# Omit every EDU_EMAIL_* value to leave email delivery disabled.

# --- Sender account (required to send mail) ---
EDU_EMAIL_CONFIGURATION_ID=transactional-smtp
EDU_EMAIL_TRANSPORT_ID=smtp
EDU_EMAIL_FROM_EMAIL=no-reply@example.com
EDU_EMAIL_FROM_NAME=Edu Service
EDU_EMAIL_REPLY_TO=support@example.com
EDU_EMAIL_FALLBACK_CONFIGURATION_IDS=
EDU_EMAIL_RATE_LIMIT_MAX=100
EDU_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
EDU_EMAIL_ACTIVE=true

# --- Branded templates + auth/unsubscribe links (required together to seed templates) ---
# CLIENT_BASE_URL must be the IsEd web origin (Next), not the API.
EDU_EMAIL_BRAND_NAME=Edu Service
EDU_EMAIL_LOGO_URL=http://127.0.0.1:3001/logos/IsEd_BrandMark.svg
EDU_EMAIL_CLIENT_BASE_URL=http://127.0.0.1:3001
EDU_EMAIL_SUPPORT_EMAIL=support@example.com
EDU_EMAIL_TERMS_URL=http://127.0.0.1:3001/terms
EDU_EMAIL_PRIVACY_URL=http://127.0.0.1:3001/privacy

# --- Durable marketing unsubscribe tokens (32+ bytes; keep stable across restarts) ---
EDU_EMAIL_UNSUBSCRIBE_HMAC_KEY=local-dev-unsubscribe-hmac-key-32b

# --- SMTP (or use Resend instead; see below) ---
EDU_SMTP_HOST=smtp.example.com
EDU_SMTP_PORT=587
EDU_SMTP_SECURE=false
EDU_SMTP_USERNAME=no-reply@example.com
EDU_SMTP_PASSWORD=replace-with-your-smtp-app-password

# --- Optional: Resend instead of SMTP ---
# EDU_EMAIL_TRANSPORT_ID=resend
# EDU_RESEND_API_KEY=re_replace_me
