# Required for commands that read or write logs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_optimizer"

# Optional local AI endpoint. HTTP is intentionally allowed for loopback development.
OLLAMA_ENDPOINT="http://localhost:11434"
# Optional request limit in milliseconds. Defaults to 600000 (ten minutes),
# which allows structured imports with the 19 GB local Qwen model to finish.
# OLLAMA_TIMEOUT_MS="600000"
# AI provider choice: auto uses OpenAI when OPENAI_API_KEY is set; otherwise Ollama.
# Set this to openai to require the cloud provider, or ollama to stay local.
LIFE_OPTIMIZER_AI_PROVIDER="auto"
# Optional cloud provider. Never commit a real token.
# OPENAI_API_KEY="sk-..."
# Optional catalog model ID for the provider selected above. The default is
# openai-gpt-4.1-mini for OpenAI or ollama-qwen-agent-32k for Ollama.
# LIFE_OPTIMIZER_AI_MODEL="openai-gpt-4.1-mini"
# Optional IANA fallback when the host timezone should not be used.
LIFE_OPTIMIZER_TIME_ZONE="America/Port_of_Spain"
# Optional absolute directory for private chat JSON. Defaults to the `agent`
# folder beside the CLI config (normally ~/.config/life-optimizer/agent).
# LIFE_OPTIMIZER_AGENT_STORAGE="/absolute/path/to/life-optimizer-agent"

# Optional user/config/telemetry overrides.
# LIFE_OPTIMIZER_USER="Your Name"
# LIFE_OPTIMIZER_CONFIG="/absolute/path/to/config.json"
# LIFE_OPTIMIZER_LOG_JSON="1"
# LIFE_OPTIMIZER_LOG_FILE="/absolute/path/to/life-optimizer-events.jsonl"
