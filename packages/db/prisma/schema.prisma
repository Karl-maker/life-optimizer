generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Naming: models are PascalCase and singular, fields camelCase (that is what the code sees).
// Tables are snake_case and plural, columns snake_case (that is what SQL sees), via @@map / @map.

enum MembershipRole {
  OWNER
  READ_ONLY

  @@map("membership_role")
}

enum AuditActorKind {
  USER
  AGENT

  @@map("audit_actor_kind")
}

enum AuditOutcome {
  SUCCEEDED
  REJECTED
  FAILED

  @@map("audit_outcome")
}

enum ApiAccessEffect {
  ALLOW
  DENY

  @@map("api_access_effect")
}

enum EmailDeliveryStatus {
  RESERVED
  SENT
  FAILED

  @@map("email_delivery_status")
}

model User {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  email       String?      @unique
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  financialAccount FinancialAccount?

  @@map("users")
}

// Financial catalog and ledger. Amounts are integer ISO-4217 minor units; provider card data is never stored.
model FinancialAccount {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  keys FinancialAccountKey[]
  entitlements Entitlement[]
  usage UsageRecord[]
  walletEntries WalletEntry[]
  paymentMethods PaymentMethodToken[]
  subscriptions Subscription[]
  invoices Invoice[]
  @@map("financial_accounts")
}
model FinancialAccountKey {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  key String @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@map("financial_account_keys")
}
model EntitlementDefinition {
  key String @id @db.Text
  description String @db.Text
  unit String @db.Text
  resetStrategy String @default("never") @map("reset_strategy") @db.Text
  resetIntervalSeconds Int? @map("reset_interval_seconds")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  priceEntitlements PriceEntitlement[]
  @@map("entitlement_definitions")
}
model Product {
  id String @id @default(uuid(7)) @db.Uuid
  key String @unique @db.Text
  name String @db.Text
  riskLevel String @map("risk_level") @db.Text
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  prices Price[]
  addOns ProductAddOn[] @relation("base_product")
  includedBy ProductAddOn[] @relation("addon_product")
  @@map("products")
}
model ProductAddOn {
  id String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  addonProductId String @map("addon_product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product Product @relation("base_product", fields: [productId], references: [id], onDelete: Restrict)
  addonProduct Product @relation("addon_product", fields: [addonProductId], references: [id], onDelete: Restrict)
  @@unique([productId, addonProductId])
  @@map("product_add_ons")
}
model Price {
  id String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  currency String @db.Char(3)
  unitAmountMinor BigInt @map("unit_amount_minor")
  frequency String @db.Text
  intervalCount Int @default(1) @map("interval_count")
  trialDays Int @default(0) @map("trial_days")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  entitlements PriceEntitlement[]
  @@index([productId, active])
  @@map("prices")
}
// A price grants a set of catalogue keys. Quantity null means unlimited access for that key.
model PriceEntitlement {
  priceId String @map("price_id") @db.Uuid
  entitlementKey String @map("entitlement_key") @db.Text
  quantity BigInt?
  price Price @relation(fields: [priceId], references: [id], onDelete: Restrict)
  definition EntitlementDefinition @relation(fields: [entitlementKey], references: [key], onDelete: Restrict)
  @@id([priceId, entitlementKey])
  @@map("price_entitlements")
}
model Entitlement {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  key String @db.Text
  quantity BigInt?
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  productId String? @map("product_id") @db.Uuid
  priceId String? @map("price_id") @db.Uuid
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, key, startsAt, endsAt])
  @@map("entitlements")
}
model UsageRecord {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  entitlementKey String @map("entitlement_key") @db.Text
  quantity BigInt
  idempotencyKey String @unique @map("idempotency_key") @db.Text
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  reversalOfId String? @map("reversal_of_id") @db.Uuid
  reversalOf UsageRecord? @relation("usage_reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals UsageRecord[] @relation("usage_reversal")
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, entitlementKey, occurredAt])
  @@index([reversalOfId])
  @@map("usage_records")
}
model WalletEntry {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  currency String @db.Char(3)
  amountMinor BigInt @map("amount_minor")
  type String @db.Text
  idempotencyKey String @unique @map("idempotency_key") @db.Text
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, currency, occurredAt])
  @@map("wallet_entries")
}
model PaymentMethodToken {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  provider String @db.Text
  tokenReference String @map("token_reference") @db.Text
  brand String? @db.Text
  last4 String? @db.Char(4)
  expiresMonth Int? @map("expires_month")
  expiresYear Int? @map("expires_year")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([provider, tokenReference])
  @@map("payment_method_tokens")
}
model Subscription {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  priceId String @map("price_id") @db.Uuid
  provider String? @db.Text
  providerReference String? @map("provider_reference") @db.Text
  lastProviderEventAt DateTime? @map("last_provider_event_at") @db.Timestamptz(3)
  status String @db.Text
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodEndsAt DateTime? @map("current_period_ends_at") @db.Timestamptz(3)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, status])
  @@unique([provider, providerReference])
  @@map("subscriptions")
}
model Invoice {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  currency String @db.Char(3)
  totalMinor BigInt @map("total_minor")
  status String @db.Text
  provider String? @db.Text
  providerReference String? @map("provider_reference") @db.Text
  lastProviderEventAt DateTime? @map("last_provider_event_at") @db.Timestamptz(3)
  dueAt DateTime? @map("due_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, status])
  @@unique([provider, providerReference])
  @@map("invoices")
}
model DunningAttempt {
  id String @id @default(uuid(7)) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  attemptNumber Int @map("attempt_number")
  status String @db.Text
  failureCategory String? @map("failure_category") @db.Text
  providerFailureCode String? @map("provider_failure_code") @db.Text
  requiresCustomerAction Boolean @default(false) @map("requires_customer_action")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  providerEventId String? @map("provider_event_id") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([invoiceId, attemptNumber])
  @@index([invoiceId, status, nextAttemptAt])
  @@map("dunning_attempts")
}
model Coupon {
  id String @id @default(uuid(7)) @db.Uuid
  code String @unique @db.Text
  percentOff Int? @map("percent_off")
  amountOffMinor BigInt? @map("amount_off_minor")
  currency String? @db.Char(3)
  maxRedemptions Int? @map("max_redemptions")
  redeemBy DateTime? @map("redeem_by") @db.Timestamptz(3)
  active Boolean @default(true)
  @@map("coupons")
}
model PaymentProviderEvent {
  id String @id @default(uuid(7)) @db.Uuid
  provider String @db.Text
  eventId String @map("event_id") @db.Text
  type String @db.Text
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  accountKey String? @map("account_key") @db.Text
  objectId String? @map("object_id") @db.Text
  objectStatus String? @map("object_status") @db.Text
  paymentStatus String? @map("payment_status") @db.Text
  providerCustomerId String? @map("provider_customer_id") @db.Text
  payloadReference String @map("payload_reference") @db.Text
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  @@unique([provider, eventId])
  @@map("payment_provider_events")
}

model Company {
  id           String       @id @default(uuid(7)) @db.Uuid
  country      String       @db.Char(2) // ISO 3166-1 alpha-2, e.g. "EE"
  registryCode String?      @map("registry_code")
  name         String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(3)
  memberships  Membership[]
  auditEvents  AuditEvent[]

  // A supplied registry code is only unique within its country's register.
  // PostgreSQL permits multiple NULLs, so companies without one remain valid.
  @@unique([country, registryCode])
  @@map("companies")
}

// Catalog metadata only: provider credentials stay in runtime configuration, never in PostgreSQL.
model AiModel {
  id                              String   @id @db.Text
  provider                        String   @db.Text
  providerModelId                 String   @map("provider_model_id") @db.Text
  displayName                     String   @map("display_name") @db.Text
  tier                            String   @db.Text
  capabilities                    Json
  inputPriceMicrousdPerMillionTokens  Int @map("input_price_microusd_per_million_tokens")
  outputPriceMicrousdPerMillionTokens Int @map("output_price_microusd_per_million_tokens")
  deprecatesAt                    DateTime? @map("deprecates_at") @db.Timestamptz(3)
  fallbackModelIds                Json @map("fallback_model_ids")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([provider, deprecatesAt])
  @@map("ai_models")
}

// Provider credentials are deliberately external; credentialReference is resolved by a transport adapter.
model EmailConfiguration {
  id                       String   @id @db.Text
  transportId              String   @map("transport_id") @db.Text
  credentialReference      String?  @map("credential_reference") @db.Text
  fromEmail                String   @map("from_email") @db.Text
  fromName                 String?  @map("from_name") @db.Text
  replyTo                  String?  @map("reply_to") @db.Text
  fallbackConfigurationIds Json     @map("fallback_configuration_ids")
  rateLimitMax             Int      @map("rate_limit_max")
  rateLimitWindowSeconds   Int      @map("rate_limit_window_seconds")
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("email_configurations")
}

model EmailTemplate {
  id              String   @id @db.Text
  subjectTemplate String   @map("subject_template") @db.Text
  headerPartial   String   @map("header_partial") @db.Text
  mainTemplate    String   @map("main_template") @db.Text
  footerPartial   String   @map("footer_partial") @db.Text
  textTemplate    String   @map("text_template") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("email_templates")
}

// Rendered content is intentionally retained only for the support retention window; no credential is stored here.
model EmailDelivery {
  id                String              @id @db.Uuid
  configurationId   String              @map("configuration_id") @db.Text
  recipient         String              @db.Text
  purpose           String              @db.Text
  unsubscribeTopic  String?             @map("unsubscribe_topic") @db.Text
  idempotencyKey    String?             @map("idempotency_key") @db.Text
  status            EmailDeliveryStatus
  renderedSubject   String              @map("rendered_subject") @db.Text
  renderedHtml      String              @map("rendered_html") @db.Text
  renderedText      String              @map("rendered_text") @db.Text
  providerMessageId String?             @map("provider_message_id") @db.Text
  failureCode       String?             @map("failure_code") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)

  @@index([recipient, createdAt])
  @@index([createdAt])
  @@map("email_deliveries")
}

model EmailSubscription {
  recipient      String    @db.Text
  topic          String    @db.Text
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(3)

  @@id([recipient, topic])
  @@map("email_subscriptions")
}

model SmsConfiguration {
 id String @id @db.Text
 adapterId String @map("adapter_id") @db.Text
 from String @db.Text
 fallbackConfigurationIds Json @map("fallback_configuration_ids")
 rateLimitMax Int @map("rate_limit_max")
 rateLimitWindowSeconds Int @map("rate_limit_window_seconds")
 active Boolean @default(true)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@map("sms_configurations")
}
model SmsTemplate {
 id String @id @db.Text
 bodyTemplate String @map("body_template") @db.Text
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@map("sms_templates")
}
model SmsDelivery {
 id String @id @db.Uuid
 configurationId String @map("configuration_id") @db.Text
 recipient String @db.Text
 purpose String @db.Text
 unsubscribeTopic String? @map("unsubscribe_topic") @db.Text
 idempotencyKey String? @map("idempotency_key") @db.Text
 status EmailDeliveryStatus
 renderedBody String @map("rendered_body") @db.Text
 providerMessageId String? @map("provider_message_id") @db.Text
 failureCode String? @map("failure_code") @db.Text
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
 @@index([recipient, createdAt])
 @@map("sms_deliveries")
}
model SmsSubscription {
 recipient String @db.Text
 topic String @db.Text
 unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(3)
 @@id([recipient, topic])
 @@map("sms_subscriptions")
}
model NotificationConfiguration {
 id String @id @db.Text
 adapterId String @map("adapter_id") @db.Text
 fallbackConfigurationIds Json @map("fallback_configuration_ids")
 rateLimitMax Int @map("rate_limit_max")
 rateLimitWindowSeconds Int @map("rate_limit_window_seconds")
 active Boolean @default(true)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@map("notification_configurations")
}
model NotificationDevice {
 id String @id @db.Text
 recipientId String @map("recipient_id") @db.Text
 adapterId String @map("adapter_id") @db.Text
 endpoint String @db.Text
 active Boolean @default(true)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@index([recipientId, active])
 @@map("notification_devices")
}
model NotificationDelivery {
 id String @id @db.Uuid
 configurationId String @map("configuration_id") @db.Text
 deviceId String @map("device_id") @db.Text
 recipientId String @map("recipient_id") @db.Text
 purpose String @db.Text
 unsubscribeTopic String? @map("unsubscribe_topic") @db.Text
 idempotencyKey String? @map("idempotency_key") @db.Text
 status EmailDeliveryStatus
 title String @db.Text
 body String @db.Text
 data Json
 providerMessageId String? @map("provider_message_id") @db.Text
 failureCode String? @map("failure_code") @db.Text
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
 @@index([recipientId, createdAt])
 @@map("notification_deliveries")
}
model NotificationSubscription {
 recipientId String @map("recipient_id") @db.Text
 topic String @db.Text
 unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(3)
 @@id([recipientId, topic])
 @@map("notification_subscriptions")
}

// Append-only business facts. Application roles receive INSERT/SELECT only;
// the SQL migration adds a trigger as a second line of defence against updates.
model AuditEvent {
  id            String         @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  companyId     String?        @map("company_id") @db.Uuid
  actorKind     AuditActorKind @map("actor_kind")
  actorId       String         @map("actor_id")
  onBehalfOfId  String?        @map("on_behalf_of_id") @db.Uuid
  action        String
  outcome       AuditOutcome
  resourceType  String         @map("resource_type")
  resourceId    String         @map("resource_id")
  correlationId String         @map("correlation_id")
  source        String
  actorSource   String?        @map("actor_source")
  changes       Json?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

// Transactional integration events. A worker publishes only committed rows.
model EventOutbox {
  id          String    @id @default(uuid(7)) @db.Uuid
  topic       String
  type        String
  version     Int
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(3)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  @@index([publishedAt, createdAt])
  @@map("event_outbox")
}

// Which person may see which company, and in what role. "Companies under my user" is a membership
// with role OWNER; an accountant later is a membership with role READ_ONLY.
model Membership {
  userId    String         @map("user_id") @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

// Endpoint-level external-integration policy. Credentials remain in the identity
// provider; this table records only stable principal IDs and support-safe reasons.
model ApiAccessPolicy {
  id               String          @id @default(uuid(7)) @db.Uuid
  principalId      String          @map("principal_id")
  endpoint         String
  effect           ApiAccessEffect
  reason           String
  supportReference String?         @map("support_reference")
  expiresAt        DateTime?       @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([principalId, endpoint, expiresAt])
  @@map("api_access_policies")
}
