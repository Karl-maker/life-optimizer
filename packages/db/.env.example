# Copy to .env (git-ignored) and adjust. The development URL is used by Prisma and the CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_optimizer"
# The integration suite requires this explicit, separate test database URL. It refuses to run
# when omitted or when it points at the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://life_optimizer_test:life_optimizer_test@localhost:5433/life_optimizer_test"
