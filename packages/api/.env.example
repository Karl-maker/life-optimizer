# Optional HTTP listener configuration for the composition service.
# EDU_API_HOST defaults to 127.0.0.1; use 0.0.0.0 only behind a trusted proxy.
EDU_API_HOST=127.0.0.1
EDU_API_PORT=3000
# Comma-separated browser origins. Omit to disable browser CORS (non-browser clients still work).
# EDU_API_ALLOWED_ORIGINS=https://app.example.com
# Exact origins to reject with a support-safe 403. This is browser CORS control,
# not a substitute for API-key/bearer authentication or endpoint authorization.
# EDU_API_BLOCKED_ORIGINS=https://compromised.example.com
# Optional non-secret support case/reference shown to callers of blocked origins.
# EDU_API_BLOCKED_ORIGIN_SUPPORT_REFERENCE=SUP-1234
# Optional Stripe adapter. Both values are required to enable Stripe checkout and signed webhooks.
# Omit both locally when payments are not configured; startup must log financial.provider.unavailable.
# EDU_STRIPE_SECRET_KEY=sk_test_replace_me
# EDU_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional PowerTranz hosted SPI Sale. All fields are required to enable it.
# The base URL must be an HTTPS /Api endpoint. Use the merchant's assigned
# page set and page name. Currency code is ISO 4217 numeric and exponent is 0-3.
# EDU_POWERTRANZ_BASE_URL=https://staging.ptranz.com/Api
# EDU_POWERTRANZ_MERCHANT_ID=replace_me
# EDU_POWERTRANZ_MERCHANT_PASSWORD=replace_me
# EDU_POWERTRANZ_PAGE_SET=PTZ/Hosted
# EDU_POWERTRANZ_PAGE_NAME=Payment
# EDU_POWERTRANZ_CURRENCY=USD
# EDU_POWERTRANZ_CURRENCY_CODE=840
# EDU_POWERTRANZ_CURRENCY_EXPONENT=2

# Optional Apple App Store Server API / Notifications V2. Set all fields to enable.
# Paths point to secret-mounted files; root certificates are Apple PKI DER files, comma separated.
# EDU_APPLE_BUNDLE_ID=com.example.edu
# EDU_APPLE_APP_ID=123456789
# EDU_APPLE_ISSUER_ID=00000000-0000-4000-8000-000000000000
# EDU_APPLE_KEY_ID=ABCDEFGHIJ
# EDU_APPLE_PRIVATE_KEY_FILE=/run/secrets/apple-in-app-purchase-key.p8
# EDU_APPLE_ROOT_CERT_FILES=/etc/edu-service/apple-root-ca-1.der,/etc/edu-service/apple-root-ca-2.der
# EDU_APPLE_ALLOW_SANDBOX=false

# Optional Google Play Developer API and authenticated Pub/Sub push. Set all fields to enable.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play-service-account.json
# EDU_GOOGLE_PLAY_PACKAGE_NAME=com.example.edu
# EDU_GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/v1/webhooks/google-play
# EDU_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=play-push@example-project.iam.gserviceaccount.com
