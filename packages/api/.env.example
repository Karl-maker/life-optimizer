# Required database connection for the API composition.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edu_service

# Required authentication secrets. Use distinct random values of at least 32 bytes;
# never commit real values. They are shared with the auth package but loaded by this API process.
EDU_AUTH_PASSWORD_PEPPER=replace-with-an-independent-32-byte-secret
EDU_AUTH_TOKEN_HMAC_KEY=replace-with-an-independent-32-byte-secret
EDU_AUTH_BLOOM_HMAC_KEY=replace-with-an-independent-32-byte-secret

# Telemetry writes safe JSON Lines to stderr and .edu-service-events.jsonl at the project root by default.
# Set to 0 to silence stderr. An optional local file and HTTPS collector receive the same redacted events.
EDU_SERVICE_LOG_JSON=1
# EDU_SERVICE_LOG_FILE=/tmp/edu-service-api-events.jsonl
# EDU_SERVICE_LOG_HTTP_ENDPOINT=https://telemetry.example.com/v1/events

# Optional HTTP listener configuration for the composition service.
# EDU_API_HOST defaults to 127.0.0.1; use 0.0.0.0 only behind a trusted proxy.
EDU_API_HOST=127.0.0.1
EDU_API_PORT=3000
# Optional non-secret deployment identifier (for example, a Git commit or image digest label).
# EDU_API_BUILD_ID=git-0e3b94f
# Comma-separated browser origins. Omit to disable browser CORS (non-browser clients still work).
# EDU_API_ALLOWED_ORIGINS=https://app.example.com
# Exact origins to reject with a support-safe 403. This is browser CORS control,
# not a substitute for API-key/bearer authentication or endpoint authorization.
# EDU_API_BLOCKED_ORIGINS=https://compromised.example.com
# Optional non-secret support case/reference shown to callers of blocked origins.
# EDU_API_BLOCKED_ORIGIN_SUPPORT_REFERENCE=SUP-1234

# ---------------------------------------------------------------------------
# Local email + unsubscribe test (copy into .env and adjust).
# Web app should listen on :3001; this API on :3000 (see EDU_API_PORT above).
# is-ed-client apps/web/.env.local → EDU_API_BASE_URL=http://127.0.0.1:3000
# Unsubscribe-only needs DATABASE_URL + EDU_EMAIL_UNSUBSCRIBE_HMAC_KEY.
# Full send needs the sender + presentation + SMTP/Resend blocks too.
# ---------------------------------------------------------------------------
# EDU_EMAIL_CONFIGURATION_ID=transactional-smtp
# EDU_EMAIL_TRANSPORT_ID=smtp
# EDU_EMAIL_FROM_EMAIL=no-reply@example.com
# EDU_EMAIL_FROM_NAME=Edu Service
# EDU_EMAIL_REPLY_TO=support@example.com
# EDU_EMAIL_FALLBACK_CONFIGURATION_IDS=
# EDU_EMAIL_RATE_LIMIT_MAX=100
# EDU_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
# EDU_EMAIL_ACTIVE=true
#
# EDU_EMAIL_BRAND_NAME=Edu Service
# EDU_EMAIL_LOGO_URL=http://127.0.0.1:3001/logos/IsEd_BrandMark.svg
# EDU_EMAIL_CLIENT_BASE_URL=http://127.0.0.1:3001
# EDU_EMAIL_SUPPORT_EMAIL=support@example.com
# EDU_EMAIL_TERMS_URL=http://127.0.0.1:3001/terms
# EDU_EMAIL_PRIVACY_URL=http://127.0.0.1:3001/privacy
#
# Keep this key stable so older unsubscribe links keep working (tokens do not expire).
# EDU_EMAIL_UNSUBSCRIBE_HMAC_KEY=local-dev-unsubscribe-hmac-key-32b
#
# EDU_SMTP_HOST=smtp.example.com
# EDU_SMTP_PORT=587
# EDU_SMTP_SECURE=false
# EDU_SMTP_USERNAME=no-reply@example.com
# EDU_SMTP_PASSWORD=replace-with-your-smtp-app-password
#
# Or Resend instead of SMTP:
# EDU_EMAIL_TRANSPORT_ID=resend
# EDU_RESEND_API_KEY=re_replace_me

# Allow the local Next app origin if you call the API from the browser (BFF usually proxies).
# EDU_API_ALLOWED_ORIGINS=http://127.0.0.1:3001

# SMS confirmations (Twilio). Set all values to send phone confirmation codes.
# EDU_SMS_CONFIGURATION_ID=transactional-twilio
# EDU_SMS_ADAPTER_ID=twilio
# EDU_SMS_FROM=+15551234567
# EDU_TWILIO_ACCOUNT_SID=ACreplace_me
# EDU_TWILIO_AUTH_TOKEN=replace_me
# EDU_SMS_FALLBACK_CONFIGURATION_IDS=
# EDU_SMS_RATE_LIMIT_MAX=20
# EDU_SMS_RATE_LIMIT_WINDOW_SECONDS=3600
# EDU_SMS_ACTIVE=true

# Push-notification sender configuration. This persists the sender configuration at startup;
# device registration and an FCM/SNS/web-push credential adapter are still required before a push can be delivered.
# EDU_NOTIFICATION_CONFIGURATION_ID=mobile-fcm
# EDU_NOTIFICATION_ADAPTER_ID=fcm
# EDU_NOTIFICATION_FALLBACK_CONFIGURATION_IDS=
# EDU_NOTIFICATION_RATE_LIMIT_MAX=100
# EDU_NOTIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600
# EDU_NOTIFICATION_ACTIVE=true

# Optional additional disposable-email domains to reject at signup (comma separated).
# EDU_AUTH_BLOCKED_EMAIL_DOMAINS=example-temporary.test

# Optional Stripe adapter. Both values are required to enable Stripe checkout and signed webhooks.
# Omit both locally when payments are not configured; startup must log financial.provider.unavailable.
# EDU_STRIPE_SECRET_KEY=sk_test_replace_me
# EDU_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional PowerTranz hosted SPI Sale. All fields are required to enable it.
# The base URL must be an HTTPS /Api endpoint. Use the merchant's assigned
# page set and page name. Currency code is ISO 4217 numeric and exponent is 0-3.
# EDU_POWERTRANZ_BASE_URL=https://staging.ptranz.com/Api
# EDU_POWERTRANZ_MERCHANT_ID=replace_me
# EDU_POWERTRANZ_MERCHANT_PASSWORD=replace_me
# EDU_POWERTRANZ_PAGE_SET=PTZ/Hosted
# EDU_POWERTRANZ_PAGE_NAME=Payment
# EDU_POWERTRANZ_CURRENCY=USD
# EDU_POWERTRANZ_CURRENCY_CODE=840
# EDU_POWERTRANZ_CURRENCY_EXPONENT=2

# Optional Apple App Store Server API / Notifications V2. Set all fields to enable.
# Paths point to secret-mounted files; root certificates are Apple PKI DER files, comma separated.
# EDU_APPLE_BUNDLE_ID=com.example.edu
# EDU_APPLE_APP_ID=123456789
# EDU_APPLE_ISSUER_ID=00000000-0000-4000-8000-000000000000
# EDU_APPLE_KEY_ID=ABCDEFGHIJ
# EDU_APPLE_PRIVATE_KEY_FILE=/run/secrets/apple-in-app-purchase-key.p8
# EDU_APPLE_ROOT_CERT_FILES=/etc/edu-service/apple-root-ca-1.der,/etc/edu-service/apple-root-ca-2.der
# EDU_APPLE_ALLOW_SANDBOX=false

# Optional Google Play Developer API and authenticated Pub/Sub push. Set all fields to enable.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play-service-account.json
# EDU_GOOGLE_PLAY_PACKAGE_NAME=com.example.edu
# EDU_GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/webhooks/google-play
# EDU_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=play-push@example-project.iam.gserviceaccount.com
