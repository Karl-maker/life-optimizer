{
  "name": "@edu-service/api",
  "version": "0.1.0",
  "description": "Fastify HTTP, WebSocket, SSE, SOAP and OpenAPI adapter for Edu Service",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@edu-service/auth": "workspace:*",
    "@edu-service/core": "workspace:*",
    "@edu-service/db": "workspace:*",
    "@edu-service/email": "workspace:*",
    "@edu-service/financial": "workspace:*",
    "@edu-service/notifications": "workspace:*",
    "@edu-service/observability": "workspace:*",
    "@edu-service/sms": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.3.4",
    "fastify": "^5.8.2",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
