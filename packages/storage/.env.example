# Required for @edu-service/storage/aws. The workload should normally use an IAM role.
EDU_STORAGE_AWS_REGION="us-east-1"
EDU_STORAGE_S3_BUCKET="edu-service-content"
# Optional public delivery origin. Must be HTTPS in production, without a trailing slash.
# EDU_STORAGE_CDN_BASE_URL="https://cdn.example.com"
# Optional only for local S3 emulators such as LocalStack or MinIO.
# EDU_STORAGE_AWS_ENDPOINT="http://localhost:4566"
# Optional for local/static credentials; use an IAM role in deployed workloads.
# AWS_ACCESS_KEY_ID="replace-me"
# AWS_SECRET_ACCESS_KEY="replace-me"
