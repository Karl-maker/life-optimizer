# Required by an AWS SNS/SQS adapter. Keep this identifier, not a credential, in source control.
EDU_EVENTS_AWS_REGION="us-east-1"
# Optional for workloads using an IAM role, required for local/static-credential authentication.
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
# Optional only for local emulators such as LocalStack; production endpoints must be AWS HTTPS endpoints.
# EDU_EVENTS_AWS_ENDPOINT="http://localhost:4566"
# LocalStack (`pnpm events:up`) uses these non-secret development values:
# EDU_EVENTS_AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="test"
# AWS_SECRET_ACCESS_KEY="test"
# EDU_EVENTS_AWS_ENDPOINT="http://localhost.localstack.cloud:4566"
# EDU_EVENTS_IDENTITY_TOPIC_ARN="arn:aws:sns:us-east-1:000000000000:identity"
