# Optional Twilio SMS sender. Omit every value to disable SMS delivery locally.
# The API composition currently supports EDU_SMS_ADAPTER_ID=twilio.
EDU_SMS_CONFIGURATION_ID=transactional-twilio
EDU_SMS_ADAPTER_ID=twilio
EDU_SMS_FROM=+15551234567
EDU_TWILIO_ACCOUNT_SID=ACreplace_me
EDU_TWILIO_AUTH_TOKEN=replace_me
EDU_SMS_FALLBACK_CONFIGURATION_IDS=
EDU_SMS_RATE_LIMIT_MAX=20
EDU_SMS_RATE_LIMIT_WINDOW_SECONDS=3600
EDU_SMS_ACTIVE=true
