# Required only when composing RedisCacheStore. It can contain credentials: keep the real value in ignored .env or deployment secrets.
# `pnpm cache:up` starts this local Redis instance with an allkeys-lfu policy.
# EDU_CACHE_REDIS_URL="redis://localhost:6379/0"
# Production should normally use TLS, for example: rediss://user:password@cache.example.com:6380/0
