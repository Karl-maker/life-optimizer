# Required. Use independent random values of at least 32 bytes; load them from AWS Secrets Manager in production.
EDU_AUTH_PASSWORD_PEPPER=replace-with-an-independent-32-byte-secret
EDU_AUTH_TOKEN_HMAC_KEY=replace-with-an-independent-32-byte-secret
EDU_AUTH_BLOOM_HMAC_KEY=replace-with-an-independent-32-byte-secret

# Optional. Whole days from 1 through 90; defaults to 30.
EDU_AUTH_DELETION_GRACE_DAYS=30

# Optional. A provider is disabled unless its client ID, secret, and exact callback URL are all configured.
EDU_AUTH_GOOGLE_CLIENT_ID=
EDU_AUTH_GOOGLE_CLIENT_SECRET=
EDU_AUTH_GOOGLE_CALLBACK_URL=https://api.example.com/v1/auth/oauth/google/callback
EDU_AUTH_GITHUB_CLIENT_ID=
EDU_AUTH_GITHUB_CLIENT_SECRET=
EDU_AUTH_GITHUB_CALLBACK_URL=https://api.example.com/v1/auth/oauth/github/callback
EDU_AUTH_FACEBOOK_CLIENT_ID=
EDU_AUTH_FACEBOOK_CLIENT_SECRET=
EDU_AUTH_FACEBOOK_CALLBACK_URL=https://api.example.com/v1/auth/oauth/facebook/callback
