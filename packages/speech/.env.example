# Required for the ElevenLabs adapters. Use a provider-issued credential; never put a real key here.
ELEVENLABS_API_KEY="replace-me"
# Required for OpenAI transcription. Use a project API key; never put a real key here.
OPENAI_API_KEY="replace-me"
# Required for AWS Transcribe Streaming when an IAM role is not available.
EDU_SPEECH_AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="replace-me"
# AWS_SECRET_ACCESS_KEY="replace-me"
