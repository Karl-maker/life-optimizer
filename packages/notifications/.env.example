# Optional push-notification sender configuration. Omit every value to disable it locally.
# This config is stored on API startup. A provider credential adapter and registered device
# are also required before the application can send a push notification.
EDU_NOTIFICATION_CONFIGURATION_ID=mobile-fcm
EDU_NOTIFICATION_ADAPTER_ID=fcm
EDU_NOTIFICATION_FALLBACK_CONFIGURATION_IDS=
EDU_NOTIFICATION_RATE_LIMIT_MAX=100
EDU_NOTIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600
EDU_NOTIFICATION_ACTIVE=true
